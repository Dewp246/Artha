# Contoh Konfigurasi Environment (Jangan isi dengan token/kredensial asli)
# Salin file ini menjadi .env.local jika Anda membutuhkan environment variables lokal

# Vercel Deployment (Diisi otomatis oleh Vercel CLI saat proses link)
# VERCEL_OIDC_TOKEN=your_vercel_token_here

# Supabase Credentials (Dapat dikonfigurasi melalui menu Pengaturan di UI aplikasi atau di js/config.js)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
